{
  "schema_version": 2,
  "project_id": "change-me",
  "kind": "software",
  "human_approval": {
    "merge": true,
    "release": true,
    "deploy": true,
    "destructive_changes": true,
    "significant_spend": true
  },
  "policies": {
    "max_parallel_workers": 2,
    "review_rounds_before_rca": 3,
    "isolate_worker_worktrees": true
  },
  "roles": [
    {
      "id": "technical-reviewer",
      "title": "Technical Reviewer",
      "mode": "reviewer",
      "profile": "reviewer",
      "focus": "Architecture, correctness, research assumptions, security, test evidence",
      "enabled": true
    },
    {
      "id": "backend-worker",
      "title": "Backend Engineer",
      "mode": "worker",
      "profile": "implementer",
      "focus": "Backend, AI, data and testable implementation",
      "enabled": true,
      "reviewer_role": "technical-reviewer"
    },
    {
      "id": "design-reviewer",
      "title": "UX/UI Designer",
      "mode": "reviewer",
      "profile": "designer",
      "focus": "UX research, interaction, accessibility and design review",
      "enabled": true
    },
    {
      "id": "frontend-worker",
      "title": "Frontend Engineer",
      "mode": "worker",
      "profile": "frontend",
      "focus": "Frontend/desktop implementation and UI tests",
      "enabled": true,
      "reviewer_role": "design-reviewer"
    }
  ]
}
